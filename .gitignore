# ==================== Application Settings ====================
APP_NAME=AI Workbench API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development

# ==================== Server Settings ====================
HOST=0.0.0.0
PORT=8002
RELOAD=True
WORKERS=1
# ==================== Database Settings ====================
# Database type: sqlite or mysql
DATABASE_TYPE=sqlite

# SQLite Configuration
SQLITE_DATABASE_PATH=./ai_workbench.db
SQLITE_CHECK_SAME_THREAD=False

# File storage (use case reference documents). Absolute path or relative to backend directory (e.g. EBS volume in production).
FILE_STORAGE_ROOT=./file_storage
USE_CASE_DOCS_SUBDIR=use_case_docs

# Demo videos root folder (absolute path or relative to backend directory).
# All .mp4 files under this folder will be available for mapping to use cases.
DEMO_VIDEOS_ROOT="C:\Users\Adhisivan Ragunathan\OneDrive - Rudhra info solution\Sciagen\Solutions\demos"

# MySQL Configuration (used when DATABASE_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_workbench
MYSQL_POOL_PRE_PING=True
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_RECYCLE=3600

# ==================== Security Settings ====================
SECRET_KEY=local-development-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Trust only proxy peers that are allowed to provide X-Forwarded-For / X-Real-IP.
# For Nginx on the same host, keep loopback. If an AWS ALB is in front of Nginx,
# add the ALB/VPC subnet CIDRs or configure Nginx real_ip and still proxy from loopback.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128


SMTP_HOST=smtp.gmail.com
    SMTP_PORT=587
    SMTP_USER=elavazhagan400@gmail.com
    SMTP_PASSWORD=mlfx vujw crhg xwui
    SMTP_FROM=elavazhagan400@gmail.com
    SMTP_FROM_EMAIL=elavazhagan400@gmail.com
    SMTP_FROM_NAME=AI Governance Workbench
    SMTP_USE_TLS=true

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_USER_ID=
MS_GRAPH_SCOPE=https://graph.microsoft.com/.default
MS_AUTHORITY_HOST=https://login.microsoftonline.com
MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Redis for registration OTP and login MFA challenge storage
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_password

# Client Credentials (for frontend authentication)
# IMPORTANT: Change CLIENT_SECRET in production and match with frontend!
CLIENT_ID=ai-workbench-frontend
CLIENT_SECRET=ai-workbench

# ==================== Logging Settings ====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_TO_CONSOLE=True
LOG_TO_FILE=True
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(module)s:%(lineno)d - %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

# ==================== AI Enhancement Settings ====================
# Set LLM_ENABLED=True only after configuring the provider values below.
# Supported providers:
# - openai_compatible (generic Bearer + /chat/completions path)
# - openai
# - groq
# - openrouter
# - together
# - xai / grok
# - local_openai
# - azure_openai
# - anthropic
# - gemini
# - ollama
LLM_ENABLED=False
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_MODEL=
# Examples:
# - Groq: https://api.groq.com/openai/v1
# - OpenAI: https://api.openai.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Together: https://api.together.xyz/v1
# - xAI: https://api.x.ai/v1
# - Azure OpenAI: https://<resource-name>.openai.azure.com
# - Anthropic: https://api.anthropic.com/v1
# - Gemini: https://generativelanguage.googleapis.com
# - Ollama: http://localhost:11434
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1100
LLM_STARTUP_SELF_TEST_ENABLED=False

# Optional provider-specific settings
LLM_AZURE_API_VERSION=2024-02-01
# If blank, Azure uses LLM_MODEL as the deployment name.
LLM_AZURE_DEPLOYMENT=
LLM_ANTHROPIC_VERSION=2023-06-01
LLM_GEMINI_API_VERSION=v1beta

# ==================== API Documentation Settings ====================
# Set to /docs to enable default FastAPI Swagger UI
DOCS_URL=
# Set to /redoc to enable default FastAPI ReDoc
REDOC_URL=
OPENAPI_URL=/openapi.json
CUSTOM_DOCS_URL=/doc

# ==================== Swagger UI Settings ====================
SWAGGER_UI_JS_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui-bundle.js
SWAGGER_UI_CSS_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui.css
SWAGGER_OAUTH2_REDIRECT_URL=/doc/oauth2-redirect

ADMIN_EMAIL=elavazhagan400@gmail.com
ADMIN_INIT_PASSWORD=ela@12345
