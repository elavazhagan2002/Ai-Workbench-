# ==================== Application Settings ====================
APP_NAME=AI Workbench API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development

# ==================== Server Settings ====================
HOST=0.0.0.0
PORT=8002
RELOAD=True
WORKERS=1

# ==================== Database Settings ====================
DATABASE_TYPE=sqlite
SQLITE_DATABASE_PATH=./ai_workbench.db
SQLITE_CHECK_SAME_THREAD=False
FILE_STORAGE_ROOT=./file_storage
USE_CASE_DOCS_SUBDIR=use_case_docs
DEMO_VIDEOS_ROOT="C:\Users\Adhisivan Ragunathan\OneDrive - Rudhra info solution\Sciagen\Solutions\demos"
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_workbench
MYSQL_POOL_PRE_PING=True
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_RECYCLE=3600

# ==================== Security Settings ====================
SECRET_KEY=local-development-secret-key
JWT_SECRET_KEY=local-development-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# ==================== Email Settings ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=elavazhagan400@gmail.com
SMTP_PASSWORD=mlfx vujw crhg xwui
SMTP_FROM=elavazhagan400@gmail.com
SMTP_FROM_EMAIL=elavazhagan400@gmail.com
SMTP_FROM_NAME=AI Governance Workbench
SMTP_USE_TLS=true

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_USER_ID=
MS_GRAPH_SCOPE=https://graph.microsoft.com/.default
MS_AUTHORITY_HOST=https://login.microsoftonline.com
MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Redis for registration OTP and login MFA challenge storage
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_password

# Client Credentials (for frontend authentication)
CLIENT_ID=ai-workbench-frontend
CLIENT_SECRET=ai-workbench

# ==================== Logging Settings ====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_TO_CONSOLE=True
LOG_TO_FILE=True
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(module)s:%(lineno)d - %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

# ==================== AI Enhancement Settings ====================
LLM_ENABLED=False
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1100
LLM_STARTUP_SELF_TEST_ENABLED=False
LLM_AZURE_API_VERSION=2024-02-01
LLM_AZURE_DEPLOYMENT=
LLM_ANTHROPIC_VERSION=2023-06-01
LLM_GEMINI_API_VERSION=v1beta

# ==================== API Documentation Settings ====================
DOCS_URL=
REDOC_URL=
OPENAPI_URL=/openapi.json
CUSTOM_DOCS_URL=/doc

# ==================== Swagger UI Settings ====================
SWAGGER_UI_JS_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui-bundle.js
SWAGGER_UI_CSS_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui.css
SWAGGER_OAUTH2_REDIRECT_URL=/doc/oauth2-redirect

ADMIN_EMAIL=elavazhagan400@gmail.com
ADMIN_INIT_PASSWORD=ela@12345
